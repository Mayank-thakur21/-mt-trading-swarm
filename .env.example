# MT Trading Swarm configuration.
#
# Copy to `.env` and edit. Every value below is the built-in default, so an empty or
# missing .env is valid. Real environment variables override .env.
#
# Units:
#   * risk limits (RISK_PER_TRADE, MAX_POSITION_PCT, MAX_GROSS_EXPOSURE,
#     MAX_DRAWDOWN_HALT, MAX_VOLATILITY) are FRACTIONS: 0.01 means 1 %;
#   * SLIPPAGE_BPS is in basis points (1 bp = 0.01 %);
#   * ALERT_PRICE_MOVE_PCT is a PERCENTAGE: 5.0 means a 5 % move.
#
# Docker Compose interpolates "$VAR" inside this file. Wrap any value that contains a
# "$" in single quotes, e.g. SMTP_PASSWORD='pa$word'.
#
# Paper trading only. Nothing here connects to a real broker.

# ------------------------------------------------------------------ application
# development | production
APP_ENV=development
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# true = one JSON object per log line (log shippers); false = readable text.
LOG_JSON=false

# ------------------------------------------------------------------ market data
# yahoo = live Yahoo Finance data (needs internet).
# synthetic = deterministic offline prices and news for demos and tests. Built-in
# scenarios: BULL (uptrend), BEAR (downtrend) and FLAT (range-bound).
DATA_PROVIDER=yahoo
# Seed of the synthetic provider (same seed gives the same prices).
SYNTHETIC_SEED=42
# How long downloaded bars and news are reused, in seconds (quotes: at most 60 s).
CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------ LLM sentiment
# anthropic (default) | openai | none.
# A provider without credentials falls back to "none" with a warning: sentiment then
# uses the built-in finance lexicon (confidence capped at 0.4).
LLM_PROVIDER=anthropic
# Claude API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=
# true = with an empty ANTHROPIC_API_KEY, let the anthropic SDK find credentials itself
# (its own environment variables or profile).
ANTHROPIC_USE_SDK_DEFAULT_AUTH=false
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. Claude Opus 5.5 always thinks; effort controls how
# hard. Headline classification is a simple, high-volume task, so low is the default.
ANTHROPIC_EFFORT=low
# Optional OpenAI provider (LLM_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Per-request timeout and SDK retries (429 / 5xx / connection errors) for either provider.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------ storage
# SQLite file for the paper portfolio, orders, trades, decisions, alert log and
# watchlist. The directory is created on demand. Docker Compose overrides this with
# sqlite:////app/data/trading_swarm.db on the named volume.
DATABASE_URL=sqlite:///./data/trading_swarm.db

# ------------------------------------------------------------------ account and costs
# Starting cash of the paper account (also the default for POST /portfolio/reset and
# for backtests).
INITIAL_CAPITAL=100000.0
# Commission = max(MIN_COMMISSION, notional x COMMISSION_RATE); 0.0005 = 5 bps.
COMMISSION_RATE=0.0005
MIN_COMMISSION=1.0
# Fill price = price x (1 +/- SLIPPAGE_BPS / 10000), against you on both sides.
SLIPPAGE_BPS=5.0

# ------------------------------------------------------------------ risk (fractions)
# Equity lost if a new position's stop is hit (0.01 = 1 %).
RISK_PER_TRADE=0.01
# Largest single position, as a share of equity.
MAX_POSITION_PCT=0.20
# Largest total market value of all positions, as a share of equity.
MAX_GROSS_EXPOSURE=0.95
# Stop-loss = entry - ATR(14) x ATR_STOP_MULTIPLE.
ATR_STOP_MULTIPLE=2.0
# Take-profit = entry + TAKE_PROFIT_R x (entry - stop), i.e. at 2R.
TAKE_PROFIT_R=2.0
# Circuit breaker: no new BUYs once equity is this far below its peak (0.20 = 20 %).
MAX_DRAWDOWN_HALT=0.20
# Veto BUYs when 20-day realised volatility (annualised) exceeds this (1.20 = 120 %).
MAX_VOLATILITY=1.20
# Annual risk-free rate for Sharpe / Sortino (0.04 = 4 %).
RISK_FREE_RATE=0.0

# ------------------------------------------------------------------ consensus
# Weighted consensus score in [-1, 1]: >= BUY_THRESHOLD -> BUY, <= SELL_THRESHOLD -> SELL.
BUY_THRESHOLD=0.25
SELL_THRESHOLD=-0.25
# Agent weights (do not need to sum to 1; each vote also counts by its confidence).
WEIGHT_TREND=0.65
WEIGHT_SENTIMENT=0.35
# true = approved decisions are executed as paper orders automatically (the API's
# auto_trade request field overrides this per call).
AUTO_TRADE=false
# Default watchlist (comma-separated). PUT /watchlist stores an override in the database.
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,NVDA

# ------------------------------------------------------------------ scheduler
# true = the API scans the watchlist in the background, first right at start-up, then
# every SCAN_INTERVAL_MINUTES.
SCHEDULER_ENABLED=false
SCAN_INTERVAL_MINUTES=60
# true = scan only during NYSE regular hours (holidays and 13:00 early closes included).
MARKET_HOURS_ONLY=false

# ------------------------------------------------------------------ API
# Comma-separated keys accepted in the X-API-Key header. Empty = authentication
# disabled (a warning is logged). Set this before exposing the API beyond localhost.
API_KEYS=
# Requests per minute per API key (or per client IP without auth); excess gets 429.
RATE_LIMIT_PER_MINUTE=60
# Comma-separated browser origins allowed to call the API; * allows any. Empty = none:
# the dashboard calls the API from its server and needs no CORS. State-changing browser
# requests from origins not listed here get 403 (cross-site request forgery guard).
CORS_ORIGINS=
# Base URL used for links in alert e-mails.
DASHBOARD_URL=http://localhost:8501

# ------------------------------------------------------------------ e-mail alerts
# Alerts are sent when SMTP_HOST, ALERT_EMAIL_FROM and ALERT_EMAIL_TO are all set.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true,
# SMTP_USERNAME=<your address>, SMTP_PASSWORD=<16-character app password>
# (https://myaccount.google.com/apppasswords, needs 2-Step Verification),
# or SMTP_USE_SSL=true with SMTP_PORT=465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on a plain connection (port 587).
SMTP_USE_TLS=true
# Implicit TLS (SMTPS, port 465). If both are true, SSL wins.
SMTP_USE_SSL=false
ALERT_EMAIL_FROM=
# Comma-separated recipients.
ALERT_EMAIL_TO=
# Signal alerts need at least this consensus confidence (0-1).
ALERT_MIN_CONFIDENCE=0.6
# Alert when a watched symbol moves at least this much in one day (percent).
ALERT_PRICE_MOVE_PCT=5.0
# Minimum minutes between repeats of the same signal / drawdown / price-move alert for
# the same symbol. Reversals are always sent; only delivered alerts start a cooldown.
ALERT_COOLDOWN_MINUTES=60

# ------------------------------------------------------------------ dashboard
# Read by the Streamlit dashboard, not by the API.
# Base URL of the API (Docker Compose sets http://api:8000).
API_URL=http://localhost:8000
# Sent as X-API-Key, only to API_URL. Must be one of API_KEYS when authentication is on.
API_KEY=
# true = visitors may change the API URL in the sidebar (off: no server-side requests
# to visitor-chosen hosts). The API_KEY above is never sent to a typed URL either way.
DASHBOARD_ALLOW_URL_OVERRIDE=false
# Timeouts in seconds for quick requests, and for analyze / batch / scan / backtest.
API_TIMEOUT_SECONDS=15
API_LONG_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------ docker compose
# Host interface and ports for the published containers. 127.0.0.1 keeps them local;
# use 0.0.0.0 only with API_KEYS set.
API_BIND=127.0.0.1
API_PORT=8000
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8501
